# ==============================================================================
# Production Environment Configuration
# Copy this file to .env.production on your production server:
#   cp .env.production.example .env.production
# Generate random 32-character secrets with:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Secret Keys (REQUIRED)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_key_in_production

# ------------------------------------------------------------------------------
# 2. Database Passwords (REQUIRED)
# ------------------------------------------------------------------------------
POSTGRES_APP_USER=postgres
POSTGRES_APP_PASSWORD=replace_with_strong_app_db_password_in_production
POSTGRES_APP_DB=app_db

POSTGRES_SANDBOX_USER=postgres
POSTGRES_SANDBOX_PASSWORD=replace_with_strong_sandbox_db_password_in_production
POSTGRES_SANDBOX_DB=sandbox_db

STUDENT_SANDBOX_USER=student_sandbox_user
STUDENT_SANDBOX_PASSWORD=replace_with_strong_student_sandbox_password_in_production

# ------------------------------------------------------------------------------
# 3. Web Service & Domain Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public domain name for Caddy automatic SSL/TLS (Let's Encrypt)
# e.g. analytics.university.edu
APP_DOMAIN=localhost

# Automated migration & seed on startup
# Keep AUTO_MIGRATE=true for initial schema creation and updates
AUTO_MIGRATE=true
# Set AUTO_SEED=false in established production to prevent overwriting existing curriculum edits
AUTO_SEED=true

# ------------------------------------------------------------------------------
# 4. Host Maintenance Ports (Bound to 127.0.0.1 only - NEVER 0.0.0.0)
# ------------------------------------------------------------------------------
APP_DB_PORT=5432
SANDBOX_DB_PORT=5435

# ------------------------------------------------------------------------------
# 5. Connection Pooling & SSL (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' if connecting to remote cloud databases (AWS RDS, Supabase, Neon)
DATABASE_SSL=false
# Max pool connections per container instance (recommended: 10)
DB_POOL_MAX=10
SANDBOX_POOL_MAX=15

# ------------------------------------------------------------------------------
# 6. Offsite Cloud Backups (Optional)
# ------------------------------------------------------------------------------
# Set S3 bucket name to automatically sync nightly backups to AWS S3 or Cloudflare R2
# S3_BUCKET=my-university-analytics-backups

# ------------------------------------------------------------------------------
# 7. Cloudflare Tunnel (For Local Computer / Homelab Deployment)
# ------------------------------------------------------------------------------
# When hosting on your local machine with docker-compose.tunnel.yml:
# Get this token from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
