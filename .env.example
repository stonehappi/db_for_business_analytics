# Database Ports
APP_DB_PORT=5432
SANDBOX_DB_PORT=5435

# Application Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# Sandbox Database (Superuser for setup / seed)
SANDBOX_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/sandbox_db

# Sandbox Database (Student restricted user for safe execution)
SANDBOX_STUDENT_DATABASE_URL=postgresql://student_sandbox_user:sandbox_safe_pw@localhost:5435/sandbox_db

# App Config
NODE_ENV=development
PORT=3000
